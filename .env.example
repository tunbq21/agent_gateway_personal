# Provider API Keys (used by config.personal.yaml)
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GEMINI_API_KEY=your-gemini-key

# Personal Admin UI Proxy Settings
GATEWAY_BRAND_NAME=TunAI Gateway
PERSONAL_UI_PORT=15005
# Set PERSONAL_UI_REQUIRE_AUTH=true and a strong token when exposing UI to the internet
PERSONAL_UI_REQUIRE_AUTH=false
PERSONAL_UI_ADMIN_TOKEN=
